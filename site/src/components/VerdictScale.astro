---
// The four verdicts a Scripter report can open with, plus the section order.
// Pass `compact` to hide the section list.
interface Props {
	compact?: boolean;
}
const { compact = false } = Astro.props;

const verdicts = [
	{ icon: '✅', name: 'Works', tone: 'works', body: 'The numbers and the full cycle hold up. It says what to keep and builds once you confirm.' },
	{ icon: '⚠️', name: 'Works with changes', tone: 'changes', body: 'The idea is sound but something breaks. You get the fix, ranked, with its trade-off.' },
	{ icon: '❌', name: "Won't work as designed", tone: 'fails', body: 'A number or a law of physics says no. You get the key figure and the nearest version that does work.' },
	{ icon: '❓', name: "Can't tell yet", tone: 'unknown', body: 'One missing fact decides it. You get the question, with a default it will use if you skip it.' },
];

const sections = ['Verdict', 'Understanding', 'How it works', 'Numbers', 'Problems', 'Better option', 'Improvements', 'Questions', 'Next'];
---

<div class="scale not-content">
	<ul class="verdicts">
		{
			verdicts.map((v) => (
				<li class={v.tone}>
					<p class="name">
						<span aria-hidden="true">{v.icon}</span> {v.name}
					</p>
					<p class="body">{v.body}</p>
				</li>
			))
		}
	</ul>
	{
		!compact && (
			<div class="sections">
				<span class="sc-label">Then, in this order</span>
				<ol>
					{sections.map((s) => (
						<li>{s}</li>
					))}
				</ol>
				<p class="hint">Empty sections are dropped. A small question, such as "which material?", gets a short direct answer instead.</p>
			</div>
		)
	}
</div>

<style>
	.scale {
		margin-top: 2rem;
		display: grid;
		gap: 1.25rem;
	}

	.verdicts {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.75rem;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
	}

	.verdicts li {
		margin: 0;
		padding: 1rem 1.1rem;
		border: 1px solid var(--sl-color-hairline-light);
		border-top: 3px solid var(--tone);
		border-radius: 0.6rem;
		background: var(--sc-sheet);
	}

	.works {
		--tone: var(--sc-works);
	}
	.changes {
		--tone: var(--sc-changes);
	}
	.fails {
		--tone: var(--sc-fails);
	}
	.unknown {
		--tone: var(--sc-unknown);
	}

	.name {
		margin: 0 0 0.4rem;
		font-weight: 600;
		color: var(--sl-color-white);
	}

	.body {
		margin: 0;
		font-size: var(--sl-text-sm);
		line-height: 1.55;
		color: var(--sl-color-gray-2);
	}

	.sections {
		display: grid;
		gap: 0.6rem;
	}

	.sections ol {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		counter-reset: sec;
	}

	.sections li {
		counter-increment: sec;
		margin: 0;
		padding: 0.3rem 0.65rem;
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: 999px;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-white);
	}

	.sections li::before {
		content: counter(sec) ' ';
		font-family: var(--__sl-font-mono);
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}

	.hint {
		margin: 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
</style>
